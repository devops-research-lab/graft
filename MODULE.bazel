module(
    name = "graft",
    version = "0.0.0",
    compatibility_level = 0,
)

# Dependencies
bazel_dep(
    name = "gazelle",
    version = "0.37.0",
)
bazel_dep(
    name = "platforms",
    version = "0.0.10",
)
bazel_dep(
    name = "protobuf",
    version = "27.2",
    repo_name = "com_google_protobuf",
)
bazel_dep(
    name = "rules_go",
    version = "0.49.0",
)
bazel_dep(
    name = "rules_pkg",
    version = "1.0.1",
)

# Extensions
tf_repos = use_extension(
    "//third_party/org_tensorflow:workspace.bzl",
    "download_tf_repositories",
)
use_repo(
    tf_repos,
    "libtensorflow_linux_x86_64_cpu",
    "libtensorflow_linux_x86_64_gpu",
    "libtensorflow_macos_arm_64_cpu",
    "libtensorflow_other_build",
    "libtensorflow_proto",
    "tensorflow_base_api_def",
    "tensorflow_go",
    "tensorflow_serving_proto",
)

libtensorflow_defaults = use_repo_rule(
    "//third_party/org_tensorflow:defaults.bzl",
    "libtensorflow_defaults",
)

libtensorflow_defaults(name = "libtensorflow_defaults")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "org_golang_google_protobuf")

# Dev dependencies
bazel_dep(
    name = "bazel_skylib",
    version = "1.7.1",
    dev_dependency = True,
)
bazel_dep(
    name = "stardoc",
    version = "0.7.0",
    dev_dependency = True,
    repo_name = "io_bazel_stardoc",
)
